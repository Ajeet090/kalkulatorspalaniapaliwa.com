---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "404 – Strona nie została znaleziona | Kalkulator spalania paliwa";
const pageDescription = "Przepraszamy, szukana strona nie istnieje lub została przeniesiona pod inny adres.";
const canonicalUrl = "https://kalkulatorspalaniapaliwa.com/404";
---

<Layout title={pageTitle} description={pageDescription} canonical={canonicalUrl} noindex={true}>
  <Navbar />

  <main class="min-h-[70vh] flex items-center justify-center py-16 px-4 sm:px-6 geist-mesh-bg">
    <div class="max-w-md w-full geist-hairline-card p-8 sm:p-10 rounded-2xl bg-white text-center space-y-6 shadow-md border border-[#ebebeb]">
      <div class="w-16 h-16 rounded-full bg-[#f2f2f2] border border-[#ebebeb] flex items-center justify-center text-2xl mx-auto font-mono text-[#8f8f8f]">
        404
      </div>

      <div class="space-y-2">
        <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#171717]">
          Strona nie została znaleziona
        </h1>
        <p class="text-xs sm:text-sm text-[#4d4d4d] leading-relaxed">
          Przepraszamy, ale strona której szukasz nie istnieje, została usunięta lub zmieniła swój adres URL.
        </p>
      </div>

      <div class="pt-2 flex flex-col gap-2">
        <a href="/" class="w-full py-2.5 px-4 rounded-full bg-[#171717] text-white text-xs font-medium hover:bg-[#333333] transition-colors shadow-2xs">
          Wróć do Kalkulatora Spalania
        </a>
        <a href="/kontakt" class="w-full py-2.5 px-4 rounded-full bg-white border border-[#ebebeb] text-[#4d4d4d] hover:text-[#171717] text-xs font-medium hover:bg-[#fafafa] transition-colors">
          Skontaktuj się z nami
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
