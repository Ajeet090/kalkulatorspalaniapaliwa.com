---
---

<footer class="bg-[#fafafa] border-t border-[#ebebeb] py-12 px-4 sm:px-6 text-xs text-[#4d4d4d]">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-start md:items-center gap-8">
    
    <!-- Left: Brand Info -->
    <div class="space-y-2">
      <div class="flex items-center gap-2">
        <a href="/" class="font-bold text-[#171717] text-sm tracking-tight hover:text-[#0070f3] transition-colors">
          Kalkulator spalania paliwa
        </a>
        <span class="px-2 py-0.5 rounded font-mono text-[10px] bg-[#ebebeb] text-[#171717] font-semibold">
          PL / PLN
        </span>
      </div>
      <p class="max-w-md text-[#8f8f8f] leading-relaxed">
        Oblicz średnie zużycie paliwa w samochodzie, sprawdź koszt przejechanej trasy oraz wydatki na benzynę, diesel lub LPG. Szybko, bezpłatnie i bez rejestracji.
      </p>
    </div>

    <!-- Center/Right: Links -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-6 text-xs font-medium">
      <div class="space-y-2">
        <span class="font-mono text-[11px] uppercase tracking-wider text-[#171717] block">Kalkulatory</span>
        <ul class="space-y-1.5 text-[#4d4d4d]">
          <li><a href="/#kalkulator-glowny" class="hover:text-[#171717] transition-colors">Średnie spalanie</a></li>
          <li><a href="/#kalkulator-kosztu-trasy" class="hover:text-[#171717] transition-colors">Koszt trasy</a></li>
          <li><a href="/#porownywarka-paliw" class="hover:text-[#171717] transition-colors">Porównywarka paliw</a></li>
          <li><a href="/#przelicznik-jednostek" class="hover:text-[#171717] transition-colors">Przelicznik MPG</a></li>
        </ul>
      </div>

      <div class="space-y-2">
        <span class="font-mono text-[11px] uppercase tracking-wider text-[#171717] block">Strona</span>
        <ul class="space-y-1.5 text-[#4d4d4d]">
          <li><a href="/o-nas" class="hover:text-[#171717] transition-colors">O nas</a></li>
          <li><a href="/kontakt" class="hover:text-[#171717] transition-colors">Kontakt</a></li>
          <li><a href="/#poradnik-i-wzory" class="hover:text-[#171717] transition-colors">Wzory i porady</a></li>
          <li><a href="/#faq" class="hover:text-[#171717] transition-colors">FAQ</a></li>
        </ul>
      </div>

      <div class="space-y-2 col-span-2 sm:col-span-1">
        <span class="font-mono text-[11px] uppercase tracking-wider text-[#171717] block">Informacje Prawne</span>
        <ul class="space-y-1.5 text-[#4d4d4d]">
          <li><a href="/polityka-prywatnosci" class="hover:text-[#171717] transition-colors">Polityka Prywatności</a></li>
          <li><a href="/regulamin" class="hover:text-[#171717] transition-colors">Regulamin Serwisu</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="max-w-6xl mx-auto mt-8 pt-6 border-t border-[#ebebeb] flex flex-col sm:flex-row items-center justify-between text-[11px] text-[#8f8f8f] gap-4">
    <div>
      © {new Date().getFullYear()} kalkulatorspalaniapaliwa.com. Wszelkie prawa zastrzeżone.
    </div>
    <div class="flex items-center gap-4">
      <a href="/polityka-prywatnosci" class="hover:text-[#171717] transition-colors">Prywatność</a>
      <span>•</span>
      <a href="/regulamin" class="hover:text-[#171717] transition-colors">Regulamin</a>
      <span>•</span>
      <a href="/kontakt" class="hover:text-[#171717] transition-colors">Kontakt</a>
    </div>
  </div>
</footer>
