<section class="relative geist-mesh-bg border-b border-[#ebebeb] py-16 sm:py-24 px-4 sm:px-6 overflow-hidden">
  <div class="max-w-4xl mx-auto text-center space-y-6">
    <!-- Eyebrow Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-[#ebebeb] shadow-2xs">
      <span class="w-2 h-2 rounded-full bg-[#0070f3] animate-pulse"></span>
      <span class="font-mono text-xs uppercase tracking-wider text-[#8f8f8f]">
        Narzędzie kalkulacji paliwa online 2026
      </span>
    </div>

    <!-- Main Heading -->
    <h1 class="text-3xl sm:text-5xl md:text-6xl font-semibold tracking-tight text-[#171717] leading-[1.1]">
      Kalkulator spalania paliwa <br class="hidden sm:inline" />
      <span class="bg-gradient-to-r from-[#171717] via-[#0070f3] to-[#7928ca] bg-clip-text text-transparent">
        i kosztów trasy
      </span>
    </h1>

    <!-- Description Paragraph -->
    <p class="max-w-2xl mx-auto text-base sm:text-lg text-[#4d4d4d] leading-relaxed">
      Oblicz średnie zużycie paliwa na 100 km, sprawdź całkowity koszt przejazdu oraz zaplanuj wydatki na benzynę (Pb95, Pb98), olej napędowy (Diesel) lub LPG.
    </p>

    <!-- Key Feature Pills -->
    <div class="pt-2 flex flex-wrap justify-center gap-2 sm:gap-3 text-xs sm:text-sm font-medium text-[#4d4d4d]">
      <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-[#ebebeb]">
        <svg class="w-4 h-4 text-[#0070f3]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
        <span>Dokładne wzory matematyczne</span>
      </div>
      <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-[#ebebeb]">
        <svg class="w-4 h-4 text-[#0070f3]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
        <span>Natychmiastowe przeliczenia</span>
      </div>
      <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-[#ebebeb]">
        <svg class="w-4 h-4 text-[#0070f3]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
        <span>Obsługa Pb, ON i LPG</span>
      </div>
      <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-[#ebebeb]">
        <svg class="w-4 h-4 text-[#0070f3]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
        <span>W 100% darmowy bez logowania</span>
      </div>
    </div>
  </div>
</section>
