---
---

<section id="kalkulator-kosztu-trasy" class="py-12 sm:py-16 px-4 sm:px-6 bg-[#fafafa] border-t border-b border-[#ebebeb]">
  <div class="max-w-4xl mx-auto">
    <!-- Section Header -->
    <div class="text-center mb-8">
      <span class="font-mono text-xs uppercase tracking-wider text-[#8f8f8f]">Planowanie Podróży</span>
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#171717] mt-1">
        Kalkulator kosztu trasy i podziału paliwa
      </h2>
      <p class="text-sm text-[#4d4d4d] mt-2 max-w-xl mx-auto">
        Znasz średnie spalanie swojego auta? Wpisz długość planowanej trasy, cenę paliwa i liczbę osób, aby wyliczyć koszty i sprawdzić składkę na osobę.
      </p>
    </div>

    <div class="geist-hairline-card rounded-xl p-5 sm:p-8 bg-white shadow-2xs">
      <form id="trip-cost-form" onsubmit="event.preventDefault();">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Form Inputs -->
          <div class="space-y-4">
            <!-- Distance -->
            <div>
              <label for="trip-dist-input" class="block text-xs font-semibold text-[#171717] mb-1">
                Planowany dystans trasy (km)
              </label>
              <div class="relative">
                <input 
                  type="number" 
                  id="trip-dist-input" 
                  value="350" 
                  min="1" 
                  step="1"
                  required
                  class="w-full px-3.5 py-2.5 rounded-md border border-[#ebebeb] text-[#171717] text-sm focus:outline-none focus:border-[#0070f3] bg-white"
                />
                <span class="absolute right-3 top-2.5 text-xs text-[#8f8f8f] pointer-events-none">km</span>
              </div>
            </div>

            <!-- Known Average Fuel Consumption -->
            <div>
              <label for="trip-avg-input" class="block text-xs font-semibold text-[#171717] mb-1">
                Średnie spalanie pojazdu (l / 100 km)
              </label>
              <div class="relative">
                <input 
                  type="number" 
                  id="trip-avg-input" 
                  value="6.8" 
                  min="0.1" 
                  step="0.1"
                  required
                  class="w-full px-3.5 py-2.5 rounded-md border border-[#ebebeb] text-[#171717] text-sm focus:outline-none focus:border-[#0070f3] bg-white"
                />
                <span class="absolute right-3 top-2.5 text-xs text-[#8f8f8f] pointer-events-none">l/100km</span>
              </div>
            </div>

            <!-- Price per Litre -->
            <div>
              <label for="trip-price-input" class="block text-xs font-semibold text-[#171717] mb-1">
                Cena paliwa za litr (zł)
              </label>
              <div class="relative">
                <input 
                  type="number" 
                  id="trip-price-input" 
                  value="6.50" 
                  min="0.01" 
                  step="0.01"
                  required
                  class="w-full px-3.5 py-2.5 rounded-md border border-[#ebebeb] text-[#171717] text-sm focus:outline-none focus:border-[#0070f3] bg-white"
                />
                <span class="absolute right-3 top-2.5 text-xs text-[#8f8f8f] pointer-events-none">zł/l</span>
              </div>
            </div>

            <!-- Number of Passengers -->
            <div>
              <label for="trip-passengers-input" class="block text-xs font-semibold text-[#171717] mb-1">
                Liczba osób w samochodzie (podział kosztów)
              </label>
              <div class="relative">
                <input 
                  type="number" 
                  id="trip-passengers-input" 
                  value="3" 
                  min="1" 
                  max="50" 
                  step="1"
                  required
                  class="w-full px-3.5 py-2.5 rounded-md border border-[#ebebeb] text-[#171717] text-sm focus:outline-none focus:border-[#0070f3] bg-white font-mono"
                />
                <span class="absolute right-3 top-2.5 text-xs text-[#8f8f8f] pointer-events-none">os.</span>
              </div>
            </div>
          </div>

          <!-- Trip Results Box -->
          <div class="bg-[#fafafa] p-5 rounded-lg border border-[#ebebeb] flex flex-col justify-between space-y-4">
            <div>
              <div class="flex items-center justify-between border-b border-[#ebebeb] pb-3 mb-4">
                <span class="font-mono text-xs uppercase tracking-wider text-[#8f8f8f]">Podsumowanie Trasy</span>
                <span class="text-xs font-medium text-[#0070f3] bg-[#d3e5ff] px-2 py-0.5 rounded">
                  Koszty podróży
                </span>
              </div>

              <!-- Main Card: Total Trip Cost -->
              <div class="bg-white p-4 rounded-md border border-[#ebebeb] mb-4">
                <span class="text-xs text-[#8f8f8f] block font-medium">Całkowity koszt paliwa na trasę</span>
                <span id="trip-res-total" class="text-3xl font-semibold text-[#171717] font-mono block mt-1">
                  154,70 zł
                </span>
                <span id="trip-res-needed-fuel" class="text-xs text-[#4d4d4d] block mt-1">
                  Potrzebne paliwo: 23,8 litra
                </span>
              </div>

              <!-- Per Passenger Breakdown -->
              <div class="bg-[#171717] text-white p-4 rounded-md shadow-xs">
                <span class="text-xs text-[#a1a1a1] uppercase font-mono tracking-wider block">
                  Składka na 1 osobę
                </span>
                <div class="flex items-baseline justify-between mt-1">
                  <span id="trip-res-per-person" class="text-2xl font-bold font-mono text-white">
                    51,57 zł
                  </span>
                  <span id="trip-res-per-person-label" class="text-xs text-[#a1a1a1]">/ osobę (przy 3 os.)</span>
                </div>
              </div>

              <!-- Additional details -->
              <div class="mt-4 pt-3 border-t border-[#ebebeb] space-y-1.5 text-xs text-[#4d4d4d]">
                <div class="flex justify-between">
                  <span>Koszt przejechania 100 km:</span>
                  <span id="trip-res-cost-100km" class="font-semibold text-[#171717] font-mono">44,20 zł</span>
                </div>
                <div class="flex justify-between">
                  <span>Koszt 1 km trasy:</span>
                  <span id="trip-res-cost-1km" class="font-semibold text-[#171717] font-mono">0,44 zł</span>
                </div>
              </div>
            </div>

            <!-- Copy Trip Summary -->
            <button 
              id="btn-copy-trip-summary" 
              type="button" 
              class="w-full px-3 py-2.5 rounded-md border border-[#ebebeb] bg-white text-[#171717] text-xs font-medium hover:bg-[#f2f2f2] focus:outline-none focus:ring-1 focus:ring-[#0070f3] transition-colors flex items-center justify-center gap-1.5"
            >
              📋 Kopiuj podsumowanie rozliczenia
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const distIn = document.getElementById('trip-dist-input') as HTMLInputElement;
  const avgIn = document.getElementById('trip-avg-input') as HTMLInputElement;
  const priceIn = document.getElementById('trip-price-input') as HTMLInputElement;
  const passengersIn = document.getElementById('trip-passengers-input') as HTMLInputElement;

  const resTotal = document.getElementById('trip-res-total');
  const resFuel = document.getElementById('trip-res-needed-fuel');
  const resPerPerson = document.getElementById('trip-res-per-person');
  const resPerPersonLabel = document.getElementById('trip-res-per-person-label');
  const resCost100km = document.getElementById('trip-res-cost-100km');
  const resCost1km = document.getElementById('trip-res-cost-1km');
  const btnCopySummary = document.getElementById('btn-copy-trip-summary');

  function formatPL(num: number, decimals: number = 2): string {
    return num.toFixed(decimals).replace('.', ',');
  }

  function updateTrip() {
    const dist = parseFloat(distIn.value) || 0;
    const avg = parseFloat(avgIn.value) || 0;
    const price = parseFloat(priceIn.value) || 0;
    const passengers = parseInt(passengersIn.value, 10) || 1;

    if (dist <= 0 || avg <= 0 || price <= 0 || passengers < 1) {
      if (resTotal) resTotal.textContent = '— zł';
      if (resFuel) resFuel.textContent = 'Potrzebne paliwo: —';
      if (resPerPerson) resPerPerson.textContent = '— zł';
      return;
    }

    const fuelNeeded = (dist * avg) / 100;
    const totalCost = fuelNeeded * price;
    const costPerPerson = totalCost / passengers;
    const cost100km = avg * price;
    const cost1km = totalCost / dist;

    if (resTotal) resTotal.textContent = `${formatPL(totalCost, 2)} zł`;
    if (resFuel) resFuel.textContent = `Potrzebne paliwo: ${formatPL(fuelNeeded, 1)} litra`;
    if (resPerPerson) resPerPerson.textContent = `${formatPL(costPerPerson, 2)} zł`;
    if (resPerPersonLabel) resPerPersonLabel.textContent = `/ osobę (przy ${passengers} os.)`;
    if (resCost100km) resCost100km.textContent = `${formatPL(cost100km, 2)} zł`;
    if (resCost1km) resCost1km.textContent = `${formatPL(cost1km, 2)} zł`;
  }

  [distIn, avgIn, priceIn, passengersIn].forEach(input => {
    if (input) input.addEventListener('input', updateTrip);
  });

  if (btnCopySummary) {
    btnCopySummary.addEventListener('click', () => {
      const dist = distIn.value;
      const total = resTotal?.textContent || '';
      const perPerson = resPerPerson?.textContent || '';
      const passengers = passengersIn.value;

      const summaryText = `Rozliczenie trasy (${dist} km):\n- Łączny koszt paliwa: ${total}\n- Składka na os. (${passengers} os.): ${perPerson}\nWyliczone na kalkulatorspalaniapaliwa.com`;

      navigator.clipboard.writeText(summaryText).then(() => {
        const orig = btnCopySummary.innerHTML;
        btnCopySummary.innerHTML = `<span class="text-[#0070f3] font-medium">✓ Skopiowano rozliczenie!</span>`;
        setTimeout(() => {
          btnCopySummary.innerHTML = orig;
        }, 2000);
      });
    });
  }

  updateTrip();
</script>
